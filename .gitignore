# Local collaboration notes.
/AGENTS.md

# Reproducible compiler output and packaged submission copies.
/artifacts/
/submission/

# Keep report inputs and final figure evidence; ignore render/review intermediates.
/submission_build/*
!/submission_build/report_sections.md
!/submission_build/dependencies.json
!/submission_build/requirements_audit.json
!/submission_build/figure6/
!/submission_build/print_figures/

# Local runtimes and language/test caches.
node_modules/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.cache/

# Operating-system and editor temporary files.
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# Deliberately retain docs/, results/, outlook/, videos/, original recordings,
# and the exam PDF. Do not ignore *.bin, *.json, *.csv, *.png, *.mp4 or *.pdf:
# these extensions also contain source material and experiment evidence.
